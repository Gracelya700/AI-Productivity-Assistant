# Environment Variables Configuration
# Copy this file to .env and fill in your API keys

# OpenAI / ChatGPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro

# Notion AI Configuration (if applicable)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Application Configuration
APP_NAME=AI Productivity Assistant
APP_ENV=development
DEBUG=true

# Server Configuration
PORT=5000
HOST=localhost

# Database Configuration (if using a database)
DATABASE_URL=sqlite:///productivity_assistant.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# Feature Toggles
FEATURE_EMAIL_GENERATOR=true
FEATURE_MEETING_SUMMARIZER=true
FEATURE_TASK_PLANNER=true
FEATURE_RESEARCH_ASSISTANT=true
FEATURE_CHATBOT=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# AI Response Settings
MAX_RESPONSE_LENGTH=2000
RESPONSE_TIMEOUT=30

# Email Configuration (for sending emails if needed)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Security
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here

# Prompting Configuration
PROMPT_VERSION=1.0
ENABLE_PROMPT_CACHING=true
